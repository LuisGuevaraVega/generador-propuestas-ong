# Copia este archivo como .env y pon tus valores reales. El .env NUNCA se sube a GitHub.

# Clave de la API de Gemini (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo principal y respaldos en orden (si uno está saturado, se prueba el siguiente)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODELOS_RESPALDO=gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-3.5-flash-lite

# Tamaño del modelo Whisper para las notas de voz (tiny, base, small)
WHISPER_MODEL=base
