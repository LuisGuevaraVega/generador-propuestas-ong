# Ejemplo de los secretos para Streamlit Community Cloud (Settings → Secrets). No se sube el archivo real.
GEMINI_API_KEY = "tu-clave-de-gemini"
GEMINI_MODEL = "gemini-3.6-flash"
GEMINI_MODELOS_RESPALDO = "gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview"
WHISPER_MODEL = "base"

# Cada visitante ve solo sus propias propuestas en "Mis propuestas" (recomendado en la versión publicada).
HISTORIAL_POR_SESION = "1"

# Opcional: si se define, la app pide esta clave antes de mostrarse. Sin ella, entra cualquiera que tenga el link.
# APP_CLAVE = "una-clave-para-tus-entrevistados"
